OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini      # optional — overrides the default model used by the agents

# Where ZizkaDB runs. Local stack: leave both unset (dev key auto-injected).
# Self-hosted server: set ZIZKADB_HOST to its URL and set ZIZKADB_API_KEY.
# ZizkaDB Cloud: set only ZIZKADB_API_KEY.
# ZIZKADB_HOST=https://zizkadb.example.com
# ZIZKADB_API_KEY=zizkadb_live_xxxx
ZIZKADB_AGENT=crewai-research
