# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Local dev stack: leave both empty. Self-hosted server: set both.
# ZizkaDB Cloud: set only ZIZKADB_API_KEY.
ZIZKADB_HOST=
ZIZKADB_API_KEY=
ZIZKADB_AGENT=claude-agent
