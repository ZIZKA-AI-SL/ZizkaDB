# Database
POSTGRES_USER=zizkadb
POSTGRES_PASSWORD=zizkadb
POSTGRES_DB=zizkadb
DATABASE_URL=postgresql://zizkadb:zizkadb@localhost:5432/zizkadb

# Qdrant
QDRANT_URL=http://localhost:6333
# Optional: Qdrant API key (infra/docker-compose.yml enables it when set).
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379
# Optional: Redis password (infra/docker-compose.yml turns on requirepass when set).
REDIS_PASSWORD=

# CORS — comma-separated exact dashboard origin(s) for credentialed cross-origin
# requests in production, e.g. https://app.example.com. Leave unset to allow "*"
# without credentials (fine for same-origin nginx setups and SDK/API callers).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# OTP rate-limit storage: redis | memory
# Default: memory when ENV=development, redis otherwise (shared across workers).
# Set explicitly in managed cloud if you want a clear rollback knob:
#   OTP_RATE_LIMIT_STORAGE=redis
# Emergency rollback (not for normal prod): OTP_RATE_LIMIT_STORAGE=memory
# OTP_RATE_LIMIT_STORAGE=memory

# OpenAI — optional on self-host (see EMBEDDINGS_ENABLED). Required for semantic
# search, memory context, and vector indexing when embeddings are enabled.
# Logging and why() work without this; search/context return 400 until configured.
OPENAI_API_KEY=sk-...

# Anthropic — required for the AI Suggestions tab. Without it, Suggestions shows
# a "not configured" setup state; the rest of the dashboard is unaffected.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Advanced (rarely needed): override the API host / version.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# Encrypts per-tenant BYOK embedding keys (defaults to JWT_SECRET if unset)
# Not passed to the containers by infra/docker-compose.yml yet: BYOK keys stored so
# far were encrypted with JWT_SECRET, and switching keys needs a re-encryption step.
# EMBEDDING_ENCRYPTION_KEY=

# Auth
# WARNING: Change BOTH secrets before any production or internet-facing deployment.
# Anyone with these values can forge valid JWTs and log in as any user.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-string

# Self-host dev key (SDK/MCP auto-use when connecting to localhost)
# Production (ENV=production): set a unique random value (openssl rand -hex 24).
# The API refuses to start with the default; it is never accepted as auth there.
DEV_API_KEY=zizkadb_dev_local

# Marks this backend as a self-hosted deployment so plan-based entitlement
# checks (e.g. API key limits) resolve to the "self_hosted" plan regardless of
# the users.plan column. Managed cloud must leave this unset (defaults to
# "managed").
DEPLOYMENT_MODE=self_hosted
# Self-hosted dashboard sign-in (no email, no signup):
#   ENV=development → one-click "Open my dashboard" button (localhost only!)
#   ENV=production  → asks for this admin token. Leave it empty and login is
#                     disabled. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SELFHOST_ADMIN_TOKEN=
# Self-hosted: vector indexing and semantic search are OFF unless you opt in.
EMBEDDINGS_ENABLED=false
# Self-hosted is always one agent with one API key (not configurable).
# API_KEY_LIMITS_ENFORCED only matters for managed deployments.

# Email — optional; enables OTP login on self-hosted dashboard (same as managed cloud)
# Gmail: Settings → Security → App Passwords → generate one
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Display name + address for OTP emails (quote the whole value — angle brackets break Docker Compose if split)
EMAIL_FROM='ZizkaDB <founder@zizka.ai>'

# App
# ENV is required by infra/docker-compose.yml. Choose one:
#   development  local machine only: dev API key zizkadb_dev_local, login-free
#                dev-token and one-click dashboard sign-in
#   production   any server reachable from other machines
# scripts/setup-local.sh sets ENV=development for you on a local machine.
# ENV=production
# PUBLIC_API_URL is read by the API server (core/api/community.py) to build
# absolute image URLs for community post media. Must be the externally
# reachable base URL of the API (no trailing slash).
PUBLIC_API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3001

# Dashboard (when running npm run dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_MODE=true
# Which edition the dashboard renders as. "self_hosted" shows only the
# owner's dashboard: / and every website page (signup, pricing, docs) redirect
# to /login, which offers the one-click / admin-token sign-in — no OTP or
# signup. It shows the four open-source tabs (Activity, Agent Behavior,
# Reports, Suggestions). "managed" (or unset) serves the full website with
# OTP signup and adds Agent Fleets. Working on the marketing pages locally?
# Set this to managed.
NEXT_PUBLIC_DEPLOYMENT_MODE=self_hosted

# Trial length for new signups (days)
TRIAL_DAYS=30

# Set on managed cloud EC2:
# ENV=production

# Optional: Calendly is managed-cloud only (not used in OSS dashboard)

# ── API key plan overrides ─────────────────────────────────────────────────────
# Managed deployments only: override per-plan caps at runtime (requires
# API_KEY_LIMITS_ENFORCED=true). Ignored for the self-hosted plan.
# API_KEY_LIMIT_PRO=2
# API_KEY_LIMIT_TEAM=5
# MAX_AGENTS_PRO=2
# MAX_AGENTS_TEAM=5

# ── Email tuning ───────────────────────────────────────────────────────────────
# SMTP connection timeout in seconds (default: 15). Increase on slow mail servers.
# EMAIL_SMTP_TIMEOUT=15

# ── Dashboard standalone (npm run dev outside Docker) ─────────────────────────
# URL the Next.js dev server proxies /v1/* requests to. Default: http://127.0.0.1:8000
# API_REWRITE_TARGET=http://127.0.0.1:8000
